{
  "name": "@iterbar/example-sveltekit",
  "version": "0.0.0",
  "private": true,
  "description": "Iterbar example: a SvelteKit app whose page has two Variants slots and shows the bar in vite dev.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist .svelte-kit",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@iterbar/svelte": "workspace:*"
  },
  "devDependencies": {
    "@iterbar/vite": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
