{
  "name": "iterbar",
  "version": "0.1.0",
  "description": "Iterbar command line: the daemon, the MCP server for coding agents, `iterbar init`, and the bundled agent skill.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "iterbar": "./dist/cli.js"
  },
  "exports": {
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js",
      "default": "./dist/store.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js",
      "default": "./dist/daemon.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/devroll.git",
    "directory": "products/iterbar/cli"
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-skill.mjs",
    "clean": "rm -rf dist coverage skills",
    "lint": "eslint src",
    "test": "pnpm --filter iterbar... build && vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/pack-manifest.mjs prepack",
    "postpack": "node scripts/pack-manifest.mjs postpack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iterbar/core": "workspace:*",
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
