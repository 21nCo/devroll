{
  "name": "@iterbar/vite",
  "version": "0.0.0",
  "private": true,
  "description": "Vite plugin that shows the Iterbar dev bar on every page in vite dev, connected to the project's daemon.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/devroll.git",
    "directory": "products/iterbar/vite"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts --sourcemap --clean --external vite --external svelte",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^7.3.7"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "@iterbar/bar": "workspace:*",
    "@iterbar/cli": "workspace:*",
    "iterbar": "workspace:*",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svelte": "^5.57.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
